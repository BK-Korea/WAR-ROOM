# GLM API Configuration
GLM_API_KEY=your_glm4_api_key_here
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# GLM Model Selection (Max Plan)
# Options: glm-4-plus (default), glm-4-flash, glm-4-air, glm-4
GLM_MODEL=glm-4-plus

# Set to "true" for mock mode (no API calls), "false" for production
GLM_MOCK_MODE=false

# Database Configuration (Optional - required for advanced features)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=war_room
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Agent Configuration
AGENT_LOG_LEVEL=info
